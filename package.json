{
  "name": "medar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "pnpm exec prisma generate",
    "build": "pnpm exec turbo build",
    "dev": "pnpm exec turbo dev",
    "lint": "pnpm exec turbo lint",
    "typecheck": "pnpm exec turbo typecheck",
    "test": "pnpm exec turbo test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,js}\"",
    "prisma:generate": "pnpm exec prisma generate",
    "prisma:migrate": "pnpm exec prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "@medar/eslint-config": "workspace:*",
    "@medar/tsconfig": "workspace:*",
    "@types/jest": "^29.5.14",
    "eslint": "^9.20.1",
    "jest": "^29.7.0",
    "prettier": "^3.5.1",
    "prisma": "^6.19.3",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.20.0"
}
